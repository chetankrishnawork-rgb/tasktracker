rules_version = '2';

// Deployed automatically via .github/workflows/deploy-firestore-rules.yml
// whenever this file changes on main.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validUser() {
      return request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validGroup() {
      return request.resource.data.keys().hasOnly([
          'name', 'color', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validTask() {
      return request.resource.data.keys().hasOnly([
          'title', 'groupId', 'priority', 'dueDate', 'completed',
          'completedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.groupId is string
        && request.resource.data.groupId.size() > 0
        && request.resource.data.groupId.size() <= 128
        && request.resource.data.priority in ['High', 'Medium', 'Low']
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() <= 10
        && request.resource.data.completed is bool
        && (request.resource.data.completedAt == null
          || request.resource.data.completedAt is timestamp)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUser();
      allow update: if isOwner(userId)
        && validUser()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /groups/{groupId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validGroup();
        allow update: if isOwner(userId)
          && validGroup()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validTask();
        allow update: if isOwner(userId)
          && validTask()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /meta/{documentId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }
    }
  }
}
